#### 메뉴 추천 로직 (기존 재활용)

```typescript
// usePersonalizedRecommendation 로직 활용
// 차이점: 현재 날씨 → 캠핑 당일 날씨 예보 사용
async function getMenuRecommendations(schedule) {
  const days = getDaysBetween(schedule.check_in, schedule.check_out);
  const menus = [];
  
  for (const day of days) {
    const weather = await getForecastForDate(schedule.lat, schedule.lng, day);
    menus.push({
      date: day,
      breakfast: recommendMeal('breakfast', weather, userProfile),
      lunch: recommendMeal('lunch', weather, userProfile),
      dinner: recommendMeal('dinner', weather, userProfile),
    });
  }
  return menus;
}
```

